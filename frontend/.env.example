# BRANDCORE — Frontend environment variables
# Copy this file to .env and fill in real values for local development.
# .env is gitignored — NEVER commit it.

# Clerk authentication — publishable key from Clerk Dashboard.
# DEVELOPMENT: pk_test_... from Clerk Development instance
# PRODUCTION:  pk_live_...  from Clerk Production instance
# Obtain from: Clerk Dashboard → API keys → Publishable key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_actual_key

# Optional: mock API mode (set 'true' to bypass backend calls during development)
# VITE_USE_MOCK_API=false
